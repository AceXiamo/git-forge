{
  "publisher": "acexiamo",
  "name": "git-forge",
  "displayName": "Git Forge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "description": "A compact Git history, branch status, and conflict resolver for VS Code Source Control.",
  "author": "AceXiamo",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/AceXiamo/git-forge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/AceXiamo/git-forge"
  },
  "bugs": {
    "url": "https://github.com/AceXiamo/git-forge/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/antfu"
  },
  "keywords": [
    "git",
    "merge",
    "conflict",
    "branch",
    "source control"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/index.cjs",
  "icon": "res/icon.png",
  "files": [
    "LICENSE.md",
    "dist/**",
    "res/*"
  ],
  "engines": {
    "vscode": "^1.97.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:git-forge.openDetails",
    "onView:gitForge.history",
    "onView:gitForge.details"
  ],
  "contributes": {
    "commands": [
      {
        "command": "git-forge.openDetails",
        "title": "Open Details Panel",
        "category": "Git Forge",
        "icon": "$(graph)"
      },
      {
        "command": "git-forge.refreshHistory",
        "title": "Refresh History",
        "category": "Git Forge",
        "icon": "$(refresh)"
      },
      {
        "command": "git-forge.copyCommitHash",
        "title": "Copy Commit Hash",
        "category": "Git Forge",
        "icon": "$(copy)"
      },
      {
        "command": "git-forge.showCommit",
        "title": "Show Commit in Terminal",
        "category": "Git Forge",
        "icon": "$(terminal)"
      },
      {
        "command": "git-forge.sync",
        "title": "Sync with Upstream",
        "category": "Git Forge",
        "icon": "$(sync)"
      },
      {
        "command": "git-forge.openConflicts",
        "title": "Open Conflict Resolver",
        "category": "Git Forge",
        "icon": "$(merge)"
      },
      {
        "command": "git-forge.abortMerge",
        "title": "Abort Current Git Operation",
        "category": "Git Forge",
        "icon": "$(debug-reverse-continue)"
      }
    ],
    "keybindings": [
      {
        "command": "git-forge.openDetails",
        "key": "ctrl+j",
        "mac": "cmd+j",
        "when": "!inputFocus"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Git Forge",
      "properties": {
        "gitForge.maxCommits": {
          "type": "number",
          "default": 80,
          "minimum": 20,
          "maximum": 300,
          "description": "Maximum number of commits shown in the Git Forge history view."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "git-forge-details",
          "title": "Git Forge",
          "icon": "res/icon.svg"
        }
      ]
    },
    "views": {
      "scm": [
        {
          "id": "gitForge.history",
          "name": "Git Forge History",
          "icon": "res/icon.svg"
        }
      ],
      "git-forge-details": [
        {
          "id": "gitForge.details",
          "name": "Details",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "git-forge.sync",
          "when": "view == gitForge.history",
          "group": "navigation"
        },
        {
          "command": "git-forge.openConflicts",
          "when": "view == gitForge.history",
          "group": "navigation"
        },
        {
          "command": "git-forge.refreshHistory",
          "when": "view == gitForge.history",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "git-forge.copyCommitHash",
          "when": "view == gitForge.history && viewItem == gitForgeCommit",
          "group": "inline"
        },
        {
          "command": "git-forge.showCommit",
          "when": "view == gitForge.history && viewItem == gitForgeCommit",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "nr build:extension && nr build:webview",
    "build:extension": "tsdown src/index.ts --external vscode",
    "build:webview": "vite build --config vite.webview.config.ts",
    "dev": "node scripts/dev.mjs",
    "dev:extension": "tsdown src/index.ts --external vscode --watch --sourcemap --no-clean",
    "dev:webview": "vite build --config vite.webview.config.ts --watch",
    "prepare": "nr update",
    "update": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "nr build",
    "release": "bumpp",
    "ext:package": "vsce package --no-dependencies",
    "ext:publish": "vsxpub --no-dependencies"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@antfu/ni": "^28.0.0",
    "@iconify/icons-solar": "^1.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.7.1",
    "bumpp": "^10.3.2",
    "eslint": "^9.39.2",
    "ovsx": "^0.10.7",
    "preact": "^10.29.2",
    "reactive-vscode": "^1.0.0-beta.2",
    "tailwindcss": "^4.3.0",
    "taze": "^19.9.2",
    "tsdown": "^0.19.0-beta.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "vscode-ext-gen": "^1.5.1",
    "vsxpub": "^0.1.2"
  }
}
